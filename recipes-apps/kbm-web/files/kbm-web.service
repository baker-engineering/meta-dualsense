[Unit]
Description=DualSense web configurator (kbm-web)
# Go's net/http binds 0.0.0.0:80 immediately and the listener accepts
# connections as soon as networkd configures eth0 later in boot. We
# don't need to wait for network.target before starting, so anchor on
# sysinit.target alongside the gadget services.
DefaultDependencies=no
After=dualsense-ffsd.service systemd-remount-fs.service
Wants=dualsense-ffsd.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/usr/bin/kbm-web
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
