[Unit]
Description=BBB user-LED animated status indicator
# Anchored on systemd-remount-fs + systemd-udevd so the LED feedback
# starts within ~1 s of the daemon being scheduled. This is the user's
# earliest visual confirmation that the system is booting.
DefaultDependencies=no
After=systemd-remount-fs.service systemd-udevd.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/usr/bin/kbm-leds
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
Nice=5

[Install]
WantedBy=sysinit.target
