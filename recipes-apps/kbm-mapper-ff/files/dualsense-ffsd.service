[Unit]
Description=DualSense FunctionFS userspace daemon (descriptor + IN/OUT/control)
# Skip systemd-udev-settle.service: it itself blocks until the entire
# coldplug queue drains, which dragged the daemon start out by ~10 s on
# this image. The daemon uses inotify on /dev/input for hot-plug, so
# any evdev nodes missing at startup are picked up later without
# udev-settle's help.
DefaultDependencies=no
Requires=dualsense-ffs.service
After=dualsense-ffs.service systemd-remount-fs.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target kbm-passthrough-setup.service kbm-passthrough.service

[Service]
Type=simple
ExecStart=/usr/bin/dualsense-ffsd /etc/kbm-mapper.conf
Restart=on-failure
RestartSec=2
RuntimeDirectory=kbm-mapper
RuntimeDirectoryMode=0755
LimitRTPRIO=99
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK CAP_SYS_ADMIN
StandardOutput=journal
StandardError=journal
Nice=-10

[Install]
WantedBy=sysinit.target
